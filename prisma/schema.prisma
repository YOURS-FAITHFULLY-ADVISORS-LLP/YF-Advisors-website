generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
}

enum TestimonialStatus {
  DRAFT
  PUBLISHED
}

enum TeamStatus {
  DRAFT
  PUBLISHED
}

model Blog {
  id              String      @id @default(cuid())

  // Basic Information
  title           String
  slug            String      @unique

  // Blog Card
  cardDescription String

  // Blog Introduction
  excerpt         String

  // Featured Image
  image           String?

  // Classification
  category        String?
  tags            String?

  // Author
  author          String      @default("YF Advisors")

  // Blog Content
  content         String?     @db.Text
  sections        BlogSection[]

  // Publishing
  status          BlogStatus  @default(DRAFT)
  publishedAt     DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model BlogSection {
  id            String    @id @default(cuid())

  blogId        String
  blog          Blog      @relation(fields: [blogId], references: [id], onDelete: Cascade)

  heading       String?

  content       String    @db.Text

  displayOrder  Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([blogId])
}

model Service {
  id                  String   @id @default(cuid())

  // Basic Information
  title               String
  slug                String   @unique
  icon                String?
  image               String?

  // Service Card (Listing Page)
  cardDescription     String      // 2–3 line summary
  keyValue            String      // Short value statement shown on card

  // Service Details Page
  description         String      @db.Text

  status              ServiceStatus @default(DRAFT)
  publishedAt         DateTime?

  // Sections
  offerings           ServiceOffering[]
  capabilities        ServiceCapability[]
  benefits            ServiceBenefit[]
  whyChooseUs         WhyChoosePoint[]
  workSteps           WorkStep[]
  relatedServices     RelatedService[] @relation("CurrentService")
  referencedBy        RelatedService[] @relation("RelatedService")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model ServiceOffering {
  id          String   @id @default(cuid())

  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  title       String
  description String

  order       Int

  createdAt   DateTime @default(now())
}

model ServiceCapability {
  id          String   @id @default(cuid())

  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  title       String
  description String

  order       Int
}

model ServiceBenefit {
  id          String   @id @default(cuid())

  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  title       String
  description String

  order       Int
}

model WhyChoosePoint {
  id          String   @id @default(cuid())

  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  title       String
  description String

  order       Int
}

model WorkStep {
  id          String   @id @default(cuid())

  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  stepNumber  Int
  title       String
  description String
}

model RelatedService {
  id          String   @id @default(cuid())

  serviceId   String
  service     Service  @relation("CurrentService", fields: [serviceId], references: [id], onDelete: Cascade)

  relatedId   String
  related     Service  @relation("RelatedService", fields: [relatedId], references: [id])

  displayOrder Int @default(0)
}

enum HighlightStatus {
  DRAFT
  PUBLISHED
}

model Highlight {
  id           String          @id @default(cuid())
  src          String
  alt          String?
  title        String?
  displayOrder Int             @default(0)
  status       HighlightStatus @default(PUBLISHED)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
  @@index([displayOrder])
}

model Testimonial {
  id            String   @id @default(cuid())

  name          String
  designation   String
  company        String?

  profileImage  String?
  initials      String?

  review        String   @db.Text

  rating        Int      @default(5)

  isVerified    Boolean  @default(true)

  status        TestimonialStatus @default(PUBLISHED)

  displayOrder  Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([displayOrder])
}

model About {
  id                 String   @id @default(cuid())

  // Hero Section
  title              String
  subtitle           String

  // Who We Are
  whoWeAreTitle      String
  whoWeAreContent    String   @db.Text

  // Why Choose Us
  whyChooseTitle     String
  whyChooseContent   String   @db.Text

  // Relations
  visionPoints       VisionPoint[]
  missionPoints      MissionPoint[]
  statistics         AboutStatistic[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model VisionPoint {
  id          String  @id @default(cuid())

  aboutId     String
  about       About   @relation(fields: [aboutId], references: [id], onDelete: Cascade)

  title       String

  order       Int
}

model MissionPoint {
  id          String  @id @default(cuid())

  aboutId     String
  about       About   @relation(fields: [aboutId], references: [id], onDelete: Cascade)

  title       String

  order       Int
}

model AboutStatistic {
  id          String  @id @default(cuid())

  aboutId     String
  about       About   @relation(fields: [aboutId], references: [id], onDelete: Cascade)

  title       String
  value       String
  icon        String?

  order       Int
}

model Homepage {
  id                String   @id @default(cuid())

  // Hero Section
  heroTitle         String
  heroDescription   String

  heroImage         String?
  heroButtonText    String?
  heroButtonLink    String?

  // 7 Orbiting Feature Cards (JSON Array)
  heroCards         String?  @db.Text

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Contact {
  id          String   @id @default(cuid())

  // Section Heading
  title       String   @default("Contact Details")

  // Office
  officeTitle String   @default("Our Office")
  address     String   @db.Text

  // Email
  emailTitle  String   @default("Email Us")
  email       String

  // Phone
  phoneTitle  String   @default("Call Us")
  phone       String

  // Social Handles
  facebookUrl  String?
  instagramUrl String?
  linkedinUrl  String?
  twitterUrl   String?
  youtubeUrl   String?

  // Optional
  googleMap   String?
  officeHours String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

model ContactSubmission {
  id          String           @id @default(cuid())
  name        String
  email       String
  phone       String
  service     String
  message     String?          @db.Text
  status      SubmissionStatus @default(NEW)
  ipAddress   String?
  notes       String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@index([createdAt])
}



model Team {
  id              String   @id @default(cuid())

  // Front Card
  name            String
  designation     String      // Founder & Partner, Partner, Advocate...
  profileImage    String

  // Back Card
  bio             String      @db.Text
  experience      String?     // "26+ Years"
  linkedinUrl     String?

  // Admin
  status          TeamStatus @default(PUBLISHED)
  displayOrder    Int @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([displayOrder])
}

model Settings {
  id                    String   @id @default(cuid())

  // Company Information
  companyName           String
  companyEmail          String?
  companyPhone          String?
  companyAddress        String?   @db.Text
  googleMapUrl          String?

  // Branding
  logo                  String?
  favicon               String?
  ogImage               String?

  // Social Media
  facebookUrl           String?
  instagramUrl          String?
  linkedinUrl           String?
  twitterUrl            String?
  youtubeUrl            String?

  // SEO Defaults
  defaultMetaTitle      String?
  defaultMetaDescription String? @db.Text
  defaultKeywords       String?   @db.Text

  // Business
  officeHours           String?   @db.Text

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AnalyticsVisitor {
  id               String               @id @default(cuid())
  visitorId        String               @unique // e.g. V-000102
  ipHash           String?
  country          String?
  city             String?
  browser          String?
  device           String?
  os               String?
  language         String?
  timezone         String?
  screenResolution String?
  referrer         String?
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  landingPage      String?
  exitPage         String?
  visitCount       Int                  @default(1)
  firstVisit       DateTime             @default(now())
  lastVisit        DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  sessions         AnalyticsSession[]
  pageViews        AnalyticsPageView[]
  events           AnalyticsEvent[]

  @@index([lastVisit])
  @@index([country])
  @@index([device])
  @@index([browser])
}

model AnalyticsSession {
  id         String              @id @default(cuid())
  visitorId  String
  startedAt  DateTime            @default(now())
  endedAt    DateTime            @default(now())
  duration   Int                 @default(0) // seconds
  bounce     Boolean             @default(true)
  pages      Int                 @default(1)
  createdAt  DateTime            @default(now())

  visitor    AnalyticsVisitor    @relation(fields: [visitorId], references: [visitorId], onDelete: Cascade)
  pageViews  AnalyticsPageView[]
  events     AnalyticsEvent[]

  @@index([visitorId])
  @@index([startedAt])
}

model AnalyticsPageView {
  id        String           @id @default(cuid())
  visitorId String
  sessionId String
  page      String
  title     String?
  enteredAt DateTime         @default(now())
  leftAt    DateTime?
  timeSpent Int              @default(0) // seconds

  visitor   AnalyticsVisitor @relation(fields: [visitorId], references: [visitorId], onDelete: Cascade)
  session   AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([visitorId])
  @@index([sessionId])
  @@index([page])
  @@index([enteredAt])
}

model AnalyticsEvent {
  id         String           @id @default(cuid())
  visitorId  String
  sessionId  String
  eventType  String           // button_click, contact_submit, whatsapp_click, phone_click, email_click, etc.
  page       String
  buttonName String?
  metadata   Json?
  createdAt  DateTime         @default(now())

  visitor    AnalyticsVisitor @relation(fields: [visitorId], references: [visitorId], onDelete: Cascade)
  session    AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([visitorId])
  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt])
}

model KnowledgeDocument {
  id         String   @id @default(cuid())
  pageUrl    String   @map("page_url")
  pageTitle  String   @map("page_title")
  chunkIndex Int      @map("chunk_index")
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("knowledge_documents")
  @@index([pageUrl])
}